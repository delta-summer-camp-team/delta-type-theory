<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>delta.delta-theorem-prover-intelliJ-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Delta Type Theory</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="delta.camp" url="https://delta.camp">Delta</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    Toy example of plugin, supporting language based on dependent type theory
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="DeltaTypeTheory"
                implementationClass="camp.delta.deltatypetheory.plugin.language.DeltaTypeTheoryFileType"
                fieldName = "INSTANCE"
                language = "DeltaTypeTheory"
                extensions = "delta"
        />
        <lang.parserDefinition
            language = "DeltaTypeTheory"
            implementationClass = "camp.delta.deltatypetheory.plugin.parser.DeltaTypeTheoryParserDefinition"
        />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <typedHandler
                implementation="camp.delta.deltatypetheory.plugin.DeltaTypeTheoryUnicodeInputHandler"/>
    </extensions>

    <!-- bracket highlighter -->
    <!-- Only the listener is registered as it itself calls the DeltaBracketHighlighter -->
    <extensions defaultExtensionNs="com.intellij">

        <editorFactoryListener
                implementation="camp.delta.deltatypetheory.plugin.DeltaEditorListener"/>
    </extensions>

</idea-plugin>